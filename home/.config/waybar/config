{
  "start_hidden": true,
  "ipc": true,
  "on-sigusr1": "hide",
  "on-sigusr2": "show",
  "layer": "top",
  "position": "top",
  "spacing": 8,
  "tray": {
    "spacing": 8
  },
  "height": 34,
"modules-left": [
    "custom/logo",
    "hyprland/workspaces",
    "custom/workspace-add"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/razer-battery",
    "custom/blackshark-battery",
    "custom/keychron-battery",
    "cpu",
    "custom/gpu",
    "memory",
    "network",
    "wireplumber",
    "battery",
    "custom/logout",
    "custom/reboot",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "all-outputs": false,
    "active-only": false,
    "format": "{icon}",
    "format-icons": {
      "default": "•",
      "active": "■",
      "urgent": "!!"
    },
    "on-click": "enable",
    "on-scroll-up": "~/.config/waybar/scripts/worskpace-activaste.sh up"
  },
  "custom/workspace-add": {
    "format": "+",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/workspace-add.sh"
  },
  "custom/logo": {
    "format": "☠ root@system",
    "tooltip": false,
    "on-click": "rofi -show drun &"
  },
  "custom/gpu": {
    "interval": 5,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "on-click": "bash -c 'command -v nvidia-settings >/dev/null && nvidia-settings'"
  },
  "custom/razer-battery": {
    "exec": "/home/ruipa/.config/waybar/scripts/razer-basilik-v3-pro-battery.sh",
    "interval": 60,
    "format": "󰍽 {}",
    "return-type": "text",
    "tooltip": true,
    "tooltip-format": "Razer Basilisk V3 Pro\nBattery: {}",
    "on-click": "polychromatic-controller"
  },
  "custom/blackshark-battery": {
    "exec": "bash -lc '/home/ruipa/.config/waybar/scripts/razer-blackshark-v3-pro-battery.sh'",
    "interval": 60,
    "format": " {}",
    "return-type": "text",
    "tooltip": true,
    "tooltip-format": "Razer BlackShark Headset\nBattery: {}",
    "on-click": "blackshark-gui"
  },
  "custom/keychron-battery": {
    "exec": "/home/ruipa/.config/waybar/scripts/keychron-battery.sh",
    "interval": 60,
    "format": "󰌌 {}",
    "return-type": "text",
    "tooltip": true,
    "tooltip-format": "Keychron K3 Max (Click to open launcher)",
    "on-click": "/home/ruipa/.config/waybar/scripts/keychron-launcher.sh"
  },
  "cpu": {
    "interval": 3,
    "format": "󰻠 cpu {usage}%",
    "states": {
      "warning": 60,
      "critical": 85
    },
    "tooltip": true,
    "tooltip-format": "CPU Usage\n{usage}% total\n\nPer-core Usage:\n{load}",
    "on-click": "kitty -e btop"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 ram {}%",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },
  "network": {
    "format-wifi": "{icon}",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-ethernet": "󰀂",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{icon} {essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰀂  {ifname}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5,
    "nospacing": 1
  },
  "wireplumber": {
    "format": "{icon}",
    "format-bluetooth": "󰂰 BT",
    "format-muted": "󰝟 MUTE",
    "format-icons": {
      "headphone": "",
      "default": [
        "󰖀",
        "󰕾",
        ""
      ]
    },
    "tooltip-format": "Volume: {volume}%",
    "on-click": "pamixer -t",
    "scroll-step": 5
  },
  "battery": {
    "format": "󰁹 {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "clock": {
    "interval": 1,
    "format": ">> {:%H:%M:%S}",
    "format-alt": ">> {:%Y-%m-%d}",
    "tooltip-format": "{calendar}"
  },
  "custom/logout": {
    "format": "󰍃",
    "tooltip-format": "Logout",
    "on-click": "~/.scripts/hypr-powermenu.sh logout"
  },
  "custom/reboot": {
    "format": "",
    "tooltip-format": "Reboot",
    "on-click": "~/.scripts/hypr-powermenu.sh restart"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Shutdown",
    "on-click": "~/.scripts/hypr-powermenu.sh shutdown"
  }
}
