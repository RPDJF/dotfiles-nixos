{
  "start_hidden": true,
  "ipc": true,
  "on-sigusr1": "hide",
  "on-sigusr2": "show",
  "layer": "top",
  "position": "top",
  "spacing": 8,
  "tray": {
    "spacing": 8
  },
  "height": 34,
  "modules-left": [
    "custom/logo",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/gpu",
    "custom/razer-battery",
    "memory",
    "network",
    "wireplumber",
    "battery",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "•",
      "active": "■",
      "urgent": "!!"
    }
  },
  "custom/logo": {
    "format": "☠ root@system",
    "tooltip": false,
    "on-click": "rofi -show drun &"
  },
  "custom/gpu": {
    "interval": 5,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "on-click": "bash -c 'command -v nvidia-settings >/dev/null && nvidia-settings'"
  },
  "custom/razer-battery": {
    "exec": "/home/ruipa/.config/waybar/scripts/razer-basilik-v3-pro-battery.sh",
    "interval": 5,
    "format": "󰍽 {}",
    "return-type": "text",
    "tooltip": true,
    "tooltip-format": "Razer Basilisk V3 Pro\nBattery: {}",
    "on-click": "polychromatic-controller"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 ram {}%"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-ethernet": "󰀂",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{icon} {essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰀂  {ifname}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5,
    "nospacing": 1
  },
  "wireplumber": {
    "format": "{icon}",
    "format-bluetooth": "󰂰 BT",
    "format-muted": "󰝟 MUTE",
    "format-icons": {
      "headphone": "",
      "default": [
        "󰖀",
        "󰕾",
        ""
      ]
    },
    "tooltip-format": "Volume: {volume}%",
    "on-click": "pamixer -t",
    "scroll-step": 5
  },
  "battery": {
    "format": "󰁹 {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "clock": {
    "interval": 1,
    "format": ">> {:%H:%M:%S}",
    "format-alt": ">> {:%Y-%m-%d}",
    "tooltip-format": "{calendar}"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "shutdown now"
  }
}
